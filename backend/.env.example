# Copia este archivo como .env (ya existe uno para desarrollo local)
PORT=3001
# Cambia este secreto antes de subir a Netlify (cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES=2h
CORS_ORIGIN=http://localhost:5173
INITIAL_BALANCE=1000
# Carpeta donde PGlite guarda la base local (PostgreSQL embebido)
PGDATA_DIR=./.data/pgdata
# Al migrar a Netlify DB (Neon) se usará:
# DATABASE_URL=postgres://...

# --- Correo para los códigos de verificación (Gmail con "contraseña de aplicación") ---
# Sin esto, en local el código se muestra en pantalla y en la consola.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=CUTTERPAY <tu-correo@gmail.com>
# Cuentas de demostración sin buzón real: su código se muestra en pantalla
DEMO_EMAIL_DOMAIN=cutterpay.com
