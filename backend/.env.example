# Copia este archivo como .env (ya existe uno para desarrollo local)
PORT=3001
# Cambia este secreto antes de subir a Netlify (cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES=2h
CORS_ORIGIN=http://localhost:5173
INITIAL_BALANCE=10000
# Carpeta donde PGlite guarda la base local (PostgreSQL embebido)
PGDATA_DIR=./.data/pgdata
# Al migrar a Netlify DB (Neon) se usará:
# DATABASE_URL=postgres://...
